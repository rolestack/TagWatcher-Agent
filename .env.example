# ── Required ──────────────────────────────────────────────────────────────────

# TagWatcher server URL (no trailing slash)
TAGWATCHER_URL=https://tagwatcher.example.com

# One-time registration token generated in TagWatcher web UI.
# After the agent registers successfully, the token is stored in /data/agent.json
# and this variable can be removed or left empty.
REGISTRATION_TOKEN=

# ── Optional ──────────────────────────────────────────────────────────────────

# How often the agent pushes container data to TagWatcher (seconds, default: 30)
# This also determines how quickly container update requests and live log streams are picked up.
# SYNC_INTERVAL_SECONDS=30

# Override the hostname reported to TagWatcher.
# By default the agent uses the system hostname, which inside Docker is usually
# the container ID (e.g. da29868a0800). Set this to a meaningful name instead.
# AGENT_HOSTNAME=my-server

# Set to "false" to skip TLS certificate verification when contacting TagWatcher.
# Useful for self-signed certificates.
# TLS_VERIFY=true

# Log level: DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO
